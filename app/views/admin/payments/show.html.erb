<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="fas fa-file-invoice me-2"></i><%= t('admin.payments.index.payment') %> #<%= @payment.id %></h1>
    <div>
      <%= link_to admin_payments_path, class: "btn btn-secondary me-2" do %>
        <i class="fas fa-arrow-left me-2"></i><%= t('common.actions.back') %>
      <% end %>
      
      <% if @payment.can_be_modified? %>
        <%= link_to edit_admin_payment_path(@payment), class: "btn btn-outline-primary" do %>
          <i class="fas fa-edit me-2"></i><%= t('common.actions.edit') %>
        <% end %>
      <% end %>

      <% if @payment.can_be_retried? %>
        <%= link_to retry_admin_payment_path(@payment), method: :patch, 
            class: "btn btn-warning ms-2", 
            data: { confirm: t('admin.payments.show.retry_confirm') } do %>
          <i class="fas fa-redo me-2"></i><%= t('admin.payments.show.retry') %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5><i class="fas fa-info-circle me-2"></i><%= t('admin.payments.show.details_header') %></h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <p><strong><%= t('admin.payments.show.id_label') %></strong> #<%= @payment.id %></p>
              <p><strong><%= t('admin.payments.show.status_label') %></strong> 
                <%= payment_status_badge(@payment.status) %>
              </p>
              <p><strong><%= t('admin.payments.show.total_label') %></strong> <span class="h5 text-primary">€ <%= number_with_precision(@payment.total, precision: 2) %></span></p>
            </div>
            <div class="col-md-6">
              <p><strong><%= t('admin.payments.show.created_label') %></strong> <%= @payment.created_at.strftime("%d/%m/%Y #{t('common.at_time')} %H:%M") %></p>
              <% if @payment.payment_date %>
                <p><strong><%= t('admin.payments.show.payment_date_label') %></strong> <%= @payment.payment_date.strftime('%d/%m/%Y') %></p>
              <% end %>
              <p><strong><%= t('admin.payments.show.reimbursements_count_label') %></strong> <%= @payment.reimboursements.count %></p>
            </div>
          </div>
                    
          <% if @payment.status_error? %>
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <strong><%= t('admin.payments.show.error_header') %></strong><br>
              <%= t('admin.payments.show.error_text') %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card mt-4">
        <div class="card-header">
          <h5><i class="fas fa-list me-2"></i><%= t('admin.payments.show.included_header') %></h5>
        </div>
        <div class="card-body">
          <% if @payment.reimboursements.any? %>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                    <th><%= t('admin.payments.show.id_th') %></th>
                    <th><%= t('admin.payments.show.user_th') %></th>
                    <th><%= t('admin.payments.show.total_th') %></th>
                    <th><%= t('admin.payments.show.iban_th') %></th>
                    <th>Fondo e progetto</th>
                    <th><%= t('admin.payments.show.status_th') %></th>
                    <th><%= t('common.labels.actions') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @payment.reimboursements.includes(:user, :bank_account, :fund, expenses: :fund).each do |reimboursement| %>
                    <tr>
                      <td>#<%= reimboursement.id %></td>
                      <td>
                        <%= reimboursement.user.name %> <%= reimboursement.user.surname %>
                        <br><small class="text-muted"><%= reimboursement.user.email %></small>
                      </td>
                      <td>€ <%= number_with_precision(reimboursement.total_amount, precision: 2) %></td>
                      <td>
                        <% if reimboursement.bank_account %>
                          <%= reimboursement.bank_account.iban %>
                          <br><small class="text-muted"><%= reimboursement.bank_account.owner %></small>
                        <% else %>
                          <span class="text-muted"><%= t('admin.payments.show.na') %></span>
                        <% end %>
                      </td>
                      <td>
                        <strong><%= reimboursement.display_fund_name %></strong>
                        <br><small class="text-muted"><%= reimboursement.project %></small>
                      </td>
                      <td>
                        <%= reimboursement_status_badge(reimboursement.status) %>
                      </td>
                      <td>
                        <%= link_to reimboursement_path(reimboursement), class: "btn btn-sm btn-outline-primary" do %>
                          <i class="fas fa-eye me-1"></i><%= t('admin.payments.show.details') %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted"><%= t('admin.payments.show.none_associated') %></p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5><i class="fas fa-cogs me-2"></i><%= t('common.labels.actions') %></h5>
        </div>
        <div class="card-body">
          <% if @payment.status_created? %>
            <%= button_to mark_as_paid_admin_payment_path(@payment), method: :patch, 
                        class: "btn btn-success w-100 mb-2",
                        data: { confirm: t('admin.payments.show.mark_as_paid_confirm') } do %>
              <i class="fas fa-check-circle me-2"></i><%= t('admin.payments.show.mark_as_paid') %>
            <% end %>
          <% elsif @payment.status_paid? %>
            <%= button_to revert_to_created_admin_payment_path(@payment), method: :patch,
                        class: "btn btn-warning w-100 mb-2",
                        data: { confirm: t('admin.payments.show.revert_confirm') } do %>
              <i class="fas fa-undo me-2"></i><%= t('admin.payments.show.revert_to_created') %>
            <% end %>
          <% end %>

          <%= link_to export_flow_admin_payment_path(@payment), class: "btn btn-info w-100 mb-2" do %>
            <i class="fas fa-download me-2"></i><%= t('admin.payments.show.export_flow') %>
          <% end %>

          <% if @payment.can_be_modified? %>
            <%= link_to edit_admin_payment_path(@payment), class: "btn btn-outline-primary w-100 mb-2" do %>
              <i class="fas fa-edit me-2"></i><%= t('admin.payments.show.edit_payment') %>
            <% end %>
          <% end %>

          <%= button_to admin_payment_path(@payment), method: :delete,
                      class: "btn btn-outline-danger w-100",
                      data: { confirm: t('admin.payments.show.delete_confirm') } do %>
            <i class="fas fa-trash me-2"></i><%= t('admin.payments.show.delete_payment') %>
          <% end %>
        </div>
      </div>

      <% if @available_reimboursements.any? && @payment.can_be_modified? %>
        <div class="card mt-3">
          <div class="card-header">
            <h6><i class="fas fa-plus-circle me-2"></i><%= t('admin.payments.show.available_title') %></h6>
          </div>
          <div class="card-body">
            <p class="small text-muted">
              <%= t('admin.payments.show.available_count', count: @available_reimboursements.count) %>
            </p>
            <%= link_to edit_admin_payment_path(@payment), class: "btn btn-sm btn-outline-primary" do %>
              <i class="fas fa-edit me-1"></i><%= t('admin.payments.show.edit_to_add') %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
