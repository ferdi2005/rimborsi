<div class="modal fade" id="whatsNewModal" tabindex="-1" aria-labelledby="whatsNewModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold" id="whatsNewModalLabel">
          <i class="fas fa-bullhorn text-primary me-2"></i><%= t('whats_new.title') %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-3">
        <%= t('whats_new.content_html') %>
      </div>
      <div class="modal-footer border-top-0 pt-0">
        <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal" id="whatsNewDismissBtn">
          <%= t('whats_new.dismiss') %>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function setupWhatsNewModal() {
      var modalEl = document.getElementById('whatsNewModal');
      if (!modalEl || modalEl.dataset.initialized) return;
      modalEl.dataset.initialized = 'true';

      if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
      }

      var dismissed = false;
      function markDismissed() {
        if (dismissed) return;
        dismissed = true;
        var csrfToken = document.querySelector('meta[name="csrf-token"]');
        fetch('<%= dismiss_whats_new_path %>', {
          method: 'PATCH',
          headers: {
            'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : '',
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        }).catch(function(err) {
          console.error('Error dismissing whats new modal:', err);
        });
      }

      modalEl.addEventListener('hidden.bs.modal', markDismissed, { once: true });
      var btn = document.getElementById('whatsNewDismissBtn');
      if (btn) {
        btn.addEventListener('click', markDismissed, { once: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupWhatsNewModal);
    } else {
      setupWhatsNewModal();
    }
    document.addEventListener('turbo:load', setupWhatsNewModal);
  })();
</script>
