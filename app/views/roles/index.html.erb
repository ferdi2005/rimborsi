<div class="container-fluid">
  <p id="notice"><%= notice %></p>
  <h1><%= t('roles.index.title') %></h1>
  <table class="table">
    <thead>
      <tr>
        <th><%= t('roles.index.label_th') %></th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @roles.each do |role| %>
      <tr>
        <td><%= role.label %></td>
        <td><%= link_to t('common.actions.show'), role %></td>
        <td><%= link_to t('common.actions.edit'), edit_role_path(role) %></td>
        <td><%= link_to t('common.actions.destroy'), role, method: :delete, data: { confirm: t('common.messages.confirm_delete') } %></td>
      </tr>
      <% end %>
    </tbody>
  </table>
  <br>
  <%= link_to t('roles.index.new'), new_role_path, class: "btn btn-primary" %>
</div>
