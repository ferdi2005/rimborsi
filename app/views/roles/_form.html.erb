<%= bootstrap_form_with(model: role) do |form| %>
  <% if role.errors.any? %>
    <div id="error_explanation">
      <h2><%= t('errors.messages.not_saved', count: role.errors.count) %></h2>
      <ul>
        <% role.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="form-group mb-3">
    <%= form.label :label, t('roles.role.label'), class: "form-label" %>
    <%= form.text_field :label, class: "form-control" %>
  </div>
  <div class="form-group mb-3">
    <%= form.submit class: 'btn btn-primary' %>
  </div>
<% end %>
